# Sunucu ve Çalışma Ortamı (Server & Runtime)
PORT=3000
NODE_ENV=development

# SQLite Veritabanı Dosya Yolu (Database Path)
# Bulut dağıtımlarında (örn. Render Kalıcı Disk) kalıcı dizin yolunu belirtin (örn. /var/data/fiyat_takip.sqlite)
DATABASE_PATH=./data/fiyat_takip.sqlite

# İsteğe Bağlı Şifreleme Anahtarı (Optional AES-256 Vault Seed)
ENCRYPTION_KEY=

# Telegram Bildirim Ayarları (Optional Server-Side Telegram Defaults)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# E-posta (SMTP) Bildirim Ayarları (Optional Server-Side Email Defaults)
NOTIFICATION_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# AI Studio / Cloud Ortam Değişkenleri
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
