# Sunucu ve Çalışma Ortamı (Server & Runtime)
NODE_ENV=development
PORT=3000

# İsteğe Bağlı CORS İzinli Kaynaklar (Optional Cross-Origin Whitelist, virgülle ayrılmış)
# Aynı alan adından (same-origin) sunulan üretim ortamlarında boş bırakılabilir.
CORS_ORIGIN=

# SQLite Veritabanı Dosya Yolu (Database Path)
# Bulut dağıtımlarında (örn. Render Persistent Disk) yazılabilir kalıcı dizin yolunu belirtin (örn. /var/data/fiyat_takip.sqlite)
DATABASE_PATH=./data/fiyat_takip.sqlite

# İsteğe Bağlı Şifreleme Anahtarı (Optional AES-256 Vault Seed)
ENCRYPTION_KEY=

# Telegram Bildirim Ayarları (Optional Server-Side Telegram Credentials)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# E-posta (SMTP) Bildirim Ayarları (Optional Server-Side Email Credentials)
NOTIFICATION_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
