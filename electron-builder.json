{
  "appId": "tr.fiyattakip.agent",
  "productName": "Fiyat Takip Agent",
  "copyright": "Copyright © 2026 Fiyat Takip Agent",
  "directories": {
    "output": "release",
    "buildResources": "public"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "server.ts",
    "src/**/*",
    "package.json"
  ],
  "mac": {
    "category": "public.app-category.shopping",
    "icon": "public/icon.svg",
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64", "universal"]
      },
      {
        "target": "zip",
        "arch": ["arm64", "x64"]
      }
    ],
    "darkModeSupport": true,
    "hardenedRuntime": true
  },
  "dmg": {
    "title": "${productName} ${version}",
    "artifactName": "Fiyat-Takip-Agent-${version}-${arch}.dmg"
  },
  "win": {
    "icon": "public/icon.svg",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "artifactName": "Fiyat-Takip-Agent-Setup-${version}.exe"
  }
}
