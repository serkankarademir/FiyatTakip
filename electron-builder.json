{
  "appId": "com.fiyattakip.agent",
  "productName": "Fiyat Takip Agent",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "server.js",
    "package.json"
  ],
  "asarUnpack": [
    "server.js",
    "node_modules/sql.js/**/*"
  ],
  "mac": {
    "category": "public.app-category.shopping",
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      },
      {
        "target": "dir",
        "arch": ["arm64", "x64"]
      }
    ]
  },
  "win": {
    "target": ["nsis", "portable"]
  }
}
